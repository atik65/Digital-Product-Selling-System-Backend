# Application Info
PROJECT_NAME="Digital Product Selling System"
VERSION=0.1.0
DEBUG=False

# Database Configuration
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5433
DB_NAME=digital_product_db

# JWT & Cookie Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Cookie Settings:
# Localhost dev: COOKIE_SECURE=False, COOKIE_SAMESITE=lax, COOKIE_DOMAIN=
# Production (same parent domain e.g. admin.subflixbd.com & api.subflixbd.com):
# COOKIE_SECURE=True, COOKIE_SAMESITE=lax, COOKIE_DOMAIN=.subflixbd.com
# Production (cross-site / localhost to live API):
# COOKIE_SECURE=True, COOKIE_SAMESITE=none, COOKIE_DOMAIN=
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMS Device Webhook Authentication
SMS_WEBHOOK_SECRET=your_secure_sms_device_webhook_secret

# Logging Configuration (console | json)
LOG_LEVEL=INFO
LOG_FORMAT=console

# Cloudflare R2 Automated Database Backup
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
BACKUP_RETENTION_DAYS=30
BACKUP_DOCKER_CONTAINER=digital-product-db

